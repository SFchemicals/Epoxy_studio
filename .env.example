# ---------------------------------------------------------------------------
# Copy to .env and adjust per environment (local / staging / production).
# .env is gitignored. Changes apply on the next `docker compose up -d`.
# ---------------------------------------------------------------------------

# --- Site -------------------------------------------------------------------
# Domain only, no scheme or slash. Base URL becomes https://<SITE_DOMAIN>/
SITE_DOMAIN=epoxy.local
# TLS: "internal" = self-signed (local). An email address = Let's Encrypt
# (staging/prod; DNS must point at this server and ports 80/443 must be open).
CADDY_TLS=internal

# --- Admin ------------------------------------------------------------------
# Admin panel path -> https://<SITE_DOMAIN>/<ADMIN_FRONTNAME>
ADMIN_FRONTNAME=admin
ADMIN_USER=admin
ADMIN_EMAIL=admin@epoxy.local
ADMIN_FIRSTNAME=Admin
ADMIN_LASTNAME=User
# Min 7 chars, letters + digits. When set, it is applied to ADMIN_USER on
# every `up`. Leave empty to leave the existing admin user untouched.
ADMIN_PASSWORD=

# 1 = sync URL/admin settings above into Magento on every `up`; 0 = skip
MAGENTO_SYNC_ON_UP=1
# Only used on a fresh install. Set it to the source env's crypt key when
# installing against an imported DB so encrypted config still decrypts.
MAGENTO_CRYPT_KEY=

# --- Database / RabbitMQ ------------------------------------------------------
# Only applied when the volume is first created (and on a fresh install).
# Changing them later does NOT change an existing DB/RabbitMQ user.
DB_NAME=magento
DB_USER=magento
DB_PASSWORD=magento
DB_ROOT_PASSWORD=root
RABBITMQ_USER=magento
RABBITMQ_PASSWORD=magento

# --- Resources ---------------------------------------------------------------
# Defaults are tuned for an 8 GB / 2 vCPU host (AWS t4g.large, arm64). All
# images are multi-arch, so the same files run on x86 dev boxes.
# Host also needs 2-4 GB swap. FPM spare values must be <= FPM_MAX_CHILDREN.
# PHP_MEMORY_LIMIT is a per-process cap (CLI too); for heavy one-off commands
# use: php -d memory_limit=4G bin/magento setup:di:compile
PHP_MEMORY_LIMIT=2G
PHP_OPCACHE_MEMORY=256
# 1 = pick up code edits immediately (dev). 0 = production; restart php after deploys.
PHP_OPCACHE_VALIDATE=1
FPM_MAX_CHILDREN=8
FPM_START_SERVERS=2
FPM_MIN_SPARE=1
FPM_MAX_SPARE=4
# Container memory caps
PHP_MEM_LIMIT=2560m
CRON_MEM_LIMIT=1536m
DB_MEM_LIMIT=1536m
DB_BUFFER_POOL=1G
OPENSEARCH_HEAP=1g
OPENSEARCH_MEM_LIMIT=1638m
REDIS_MAXMEMORY=640mb

# --- Docker / dev -------------------------------------------------------------
UID=1000
GID=1000
XDEBUG_MODE=off
# MEDIA_PATH=./pub/media
