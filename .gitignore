# =====================================================================
# Magento 2 project .gitignore
# Based on the official magento/magento2 .gitignore, adapted for a
# project repository (custom code in app/, dependencies via Composer).
# =====================================================================

# ---------------------------------------------------------------------
# Composer dependencies
# ---------------------------------------------------------------------
/vendor/*
!/vendor/.htaccess

# ---------------------------------------------------------------------
# Generated code (DI, factories, proxies, interceptors)
# ---------------------------------------------------------------------
/generated/*
!/generated/.htaccess

# ---------------------------------------------------------------------
# var/ – logs, cache, sessions, reports, preprocessed views, imports
# ---------------------------------------------------------------------
/var/*
!/var/.htaccess

# ---------------------------------------------------------------------
# Media (uploaded product images, CMS/wysiwyg, captcha, etc.)
# ---------------------------------------------------------------------
/pub/media/*
!/pub/media/.htaccess
!/pub/media/customer/.htaccess
!/pub/media/downloadable/.htaccess
!/pub/media/import/.htaccess
!/pub/media/theme_customization/.htaccess

# ---------------------------------------------------------------------
# Deployed static content
# ---------------------------------------------------------------------
/pub/static/*
!/pub/static/.htaccess

# ---------------------------------------------------------------------
# Environment-specific config & secrets (never commit)
# app/etc/config.php IS committed – it holds the module/theme list.
# ---------------------------------------------------------------------
/app/etc/env.php
/app/etc/env.*.php
/auth.json
/.env
/.env.*

# ---------------------------------------------------------------------
# Sitemaps / robots generated by Magento
# ---------------------------------------------------------------------
/sitemap
/sitemap.xml
/pub/sitemap
/pub/sitemap*.xml
/robots.txt
/pub/robots.txt

# ---------------------------------------------------------------------
# Frontend tooling (Grunt / npm)
# ---------------------------------------------------------------------
/node_modules/
/package.json
/package-lock.json
/Gruntfile.js
/grunt-config.json
/dev/tools/grunt/configs/local-themes.js

# ---------------------------------------------------------------------
# Test / tool artifacts
# ---------------------------------------------------------------------
/dev/tests/*/tmp/*
/dev/tests/*/var/*
/dev/tests/*/phpunit.xml
/dev/tests/*/allure-results/
/dev/tests/acceptance/tests/_output/*
/dev/tests/functional/generated/
/dev/tests/functional/var/
/dev/tests/integration/etc/install-config-mysql.php
/dev/tests/api-functional/config/install-config-mysql.php
/dev/tests/api-functional/soap.xml
/dev/tests/api-functional/rest.xml
/dev/tests/api-functional/graphql.xml
/dev/tests/setup-integration/etc/install-config-*.php
.phpunit.result.cache
.php_cs.cache
.php-cs-fixer.cache
.phpcs-cache

# ---------------------------------------------------------------------
# Backups, dumps & archives
# ---------------------------------------------------------------------
*.sql
*.sql.gz
*.tgz
*.tar.gz
*.zip
/var/backups/

# ---------------------------------------------------------------------
# Logs (anywhere)
# ---------------------------------------------------------------------
*.log

# ---------------------------------------------------------------------
# IDE / editor / OS files
# ---------------------------------------------------------------------
/.idea/
/.vscode/
/.buildpath
/.cache
/.metadata
/.project
/.settings
/nbproject
*.swp
*.swo
*~
.DS_Store
Thumbs.db
